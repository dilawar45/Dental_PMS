# ══════════════════════════════════════════════
# Dental PMS — Environment Variables
# Copy to .env and fill in your values
# ══════════════════════════════════════════════

# ── Database ──────────────────────────────────
# Use Supabase Connection Pooler (Port 5432 for Session mode / migrations)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-dashboard

# ── Auth ──────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ── Agent Service & Simulator ─────────────────
ANTHROPIC_API_KEY=your-api-key
AGENT_SERVICE_URL=http://localhost:8000
SIMULATOR_SHARED_SECRET=your-simulator-shared-secret-key
LLM_PROVIDER=mock
SESSION_STORE=memory
AGENT_PORT=8000
DEFAULT_CLINIC_ID=b398700a-f746-4a45-afc0-b1020cda02a8

# ── Provider Selection ────────────────────────
# Each provider can be "mock" (default, no network) or "real" (stub)
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
SOCIAL_PROVIDER=mock
STORAGE_PROVIDER=mock
PDF_PROVIDER=mock
AI_PROVIDER=mock
SMS_PROVIDER=mock          # mock | twilio | telenor
OTP_PROVIDER=mock          # mock | twilio | jazz

# ── Patient Mobile API & Auth ─────────────────
PATIENT_JWT_SECRET=your-random-64-character-patient-jwt-secret-string-here
PATIENT_API_ALLOWED_ORIGINS=*
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
PATIENT_CHAT_RATE_LIMIT=30

# ── Inngest ───────────────────────────────────
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
INNGEST_DEV=1
