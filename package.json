{
  "name": "dental-pms",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @dental-pms/db generate",
    "db:migrate": "pnpm --filter @dental-pms/db migrate",
    "db:seed": "pnpm --filter @dental-pms/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.6",
    "prettier": "^3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8",
    "next": "^15",
    "react": "^18",
    "react-dom": "^18"
  }
}
